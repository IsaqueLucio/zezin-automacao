    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst resultado = [];\n\nfor (const item of items) {\n  const submitted = new Date(item.json.submitted_at);\n  const agora = new Date();\n  const diffMinutos = (agora - submitted) / 1000 / 60;\n\n  if (diffMinutos > 2) {\n    resultado.push({\n      json: {\n        ...item.json,\n        tempo_parado: Math.round(diffMinutos)\n      }\n    });\n  }\n}\n\nif (resultado.length === 0) return [{ json: { vazio: true } }];\nreturn resultado;"
      },
